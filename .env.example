# Configure these in your hosting environment. The app does not automatically load .env files.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Billing defaults to disabled until Paynow merchant setup and testing are complete.
BILLING_MODE=disabled
# PAYNOW_INTEGRATION_ID=your_usd_integration_id
# PAYNOW_INTEGRATION_KEY=server_side_secret_only
# PAYNOW_TEST_EMAIL=merchant_email_for_test_checkout
# BILLING_SUPPORT_EMAIL=your_customer_support_email
# PAYNOW_LIVE_APPROVED=true
# DATA_DIR=/path/to/persistent/workspace-data
# Local development retains SQLite unless explicitly switched:
STORAGE_BACKEND=sqlite
# For cloud storage, use STORAGE_BACKEND=dynamodb and configure:
# AWS_REGION=eu-north-1
# DYNAMODB_TABLE=bussiness-workspace
# Supply AWS authentication only through your host's secure environment or an IAM role.
# Never commit access keys or place them in frontend variables.
