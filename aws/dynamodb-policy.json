{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkspaceTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:eu-north-1:YOUR_AWS_ACCOUNT_ID:table/business-workspace"
    }
  ]
}
